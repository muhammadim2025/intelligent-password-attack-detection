# Local development example. Copy to .env and replace secrets locally.
# Never commit .env or real credentials.
FLASK_APP=app
FLASK_DEBUG=1
55c3f683cf2a6b8d04606ab7c7be8eae083b66bed464fe6411dce5fd95fe7a5a
52d59c928357b4d0b904276a4ba5b1ddabf922ea8873af47ead5935602ee8e9c
# SQLite is used by default for local development when DATABASE_URL is not set.
DATABASE_PATH=instance/research.db
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require  # optional local PostgreSQL/Neon test target
AUTH_EVENT_RETENTION_ENABLED=false
AUTH_EVENT_RETENTION_DAYS=90
ADMIN_PROVISIONING_CODE=replace-with-a-local-provisioning-code
SOC_DEMO_MODE=false
MANUAL_DETECTION_LAB=false

# Production/Render (set in the platform environment, not in .env):
# FLASK_DEBUG=0
# SECRET_KEY=<strong-random-secret>
# PRIVACY_HMAC_KEY=<separate-strong-random-secret>
# DATABASE_URL=<Neon PostgreSQL connection string>  # preferred for Render; fresh/empty database
# # DATABASE_PATH=/var/data/app.db  # optional SQLite-on-disk fallback only if using a persistent disk
# SESSION_COOKIE_SECURE=true
# TRUST_PROXY_HEADERS=true
# MANUAL_DETECTION_LAB=false
# SOC_DEMO_MODE=false
# AUTH_EVENT_RETENTION_ENABLED=true
# AUTH_EVENT_RETENTION_DAYS=90


